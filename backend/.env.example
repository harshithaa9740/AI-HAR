# ==============================================================================
# AURAVISION Backend Configuration (.env)
# 100% Local-First & Offline Architecture
# ==============================================================================

# Application Environment (development / staging / production)
APP_ENV=development
APP_NAME=AURAVISION-Backend
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# AI Pipeline Mode (mock / development / production)
# Set to 'mock' for standalone demonstration scenarios
AI_MODE=mock

# Database Configuration (SQLite Local File)
DATABASE_URL=sqlite:///./data/auravision.db

# Video Source (0 for webcam, /path/to/video.mp4, or rtsp://...)
VIDEO_SOURCE=0
VIDEO_RECORDING_ENABLED=true
VIDEO_FRAME_WIDTH=1280
VIDEO_FRAME_HEIGHT=720
VIDEO_FPS=30

# Local IP Video Streaming (Optional broadcast to specific destination IP/Port)
STREAM_ENABLED=false
STREAM_DESTINATION_IP=127.0.0.1
STREAM_PORT=8554

# Sequence & AI Confidence Threshold (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.70

# Voice Alert Engine (Local TTS or Mock Voice)
VOICE_ENABLED=true
VOICE_ENGINE=mock

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Paths to Custom AI Model Weights (Optional when AI_MODE=production)
MODEL_OBJECT_PATH=
MODEL_ACTIVITY_PATH=
MODEL_POSE_PATH=
