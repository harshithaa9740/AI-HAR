# ==============================================================================
# AURAVISION Backend Configuration (.env)
# 100% Local-First & Offline Architecture
# ==============================================================================

# Application Environment (development / staging / production)
APP_ENV=development
APP_NAME=AURAVISION-Backend
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# AI Pipeline Mode (mock / development / production)
# Set to 'mock' for standalone demonstration scenarios
AI_MODE=mock

# Database Engine Selection: "sqlite" (default offline) or "postgres" (cloud Ground-Station)
# To use Supabase PostgreSQL, set DB_ENGINE=postgres and configure SUPABASE_DB_URL below.
DB_ENGINE=sqlite

# SQLite Database URL (Default for local offline operation)
# Path: backend/data/auravision.db
# Initialized automatically on startup via app.db.database.init_db()
DATABASE_URL=sqlite:///./data/auravision.db

# Supabase / PostgreSQL Ground-Station Configuration (Step 5)
# When DB_ENGINE=postgres, SUPABASE_DB_URL is required. Keep disabled during local offline operations.
# Never commit real credentials to source control. Exclude .env from git.
#
# Direct Connection (Port 5432):
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres?sslmode=require
#
# Connection Pooler / Supavisor (Port 6543, Recommended for Web Backends):
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT-ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Project API metadata:
# SUPABASE_URL=https://[PROJECT-ID].supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here (BACKEND-ONLY, NEVER IN FRONTEND)
# SUPABASE_SYNC_ENABLED=false
# SUPABASE_STORAGE_BUCKET_RECORDINGS=auravision-recordings
# SUPABASE_STORAGE_BUCKET_ARTIFACTS=auravision-artifacts

# Video Source (0 for webcam, /path/to/video.mp4, or rtsp://...)
VIDEO_SOURCE=0
VIDEO_RECORDING_ENABLED=true
VIDEO_FRAME_WIDTH=1280
VIDEO_FRAME_HEIGHT=720
VIDEO_FPS=30

# Local IP Video Streaming (Optional broadcast to specific destination IP/Port)
STREAM_ENABLED=false
STREAM_DESTINATION_IP=127.0.0.1
STREAM_PORT=8554

# Sequence & AI Confidence Threshold (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.70

# Voice Alert Engine (Local TTS or Mock Voice)
VOICE_ENABLED=true
VOICE_ENGINE=mock

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Paths to Custom AI Model Weights (Optional when AI_MODE=production)
MODEL_OBJECT_PATH=
MODEL_ACTIVITY_PATH=
MODEL_POSE_PATH=
